# EXECUTION APP PORT
PORT=3000

# CORS is enabled only when CORS_ORIGIN exists.
# TypeORM synchronize is controlled explicitly by DB_SYNCHRONIZE below.

# DEFAULT HOST FILE 
HOST=http://localhost:3000

# Single allowed origin for Angular dev server or another browser client.
# In production with Angular served by NestJS, this can be omitted.
CORS_ORIGIN=http://localhost:4200

# DATABASE CONFIGURATION
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=intranet
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# TypeORM schema sync. Use true only in local development.
# Staging/production must use false and run migrations instead.
DB_SYNCHRONIZE=true

# Base URL of the Identity Provider (OAuth / Authorization Server)
IDENTITY_HUB_URL=http://localhost:8000

# Base URL for Identity Hub internal service-to-service endpoints
# In development it can point to the same backend as IDENTITY_HUB_URL.
IDENTITY_HUB_INTERNAL_URL=http://localhost:8000

# Optional explicit JWKS URL. If omitted, the backend uses IDENTITY_HUB_URL/.well-known/jwks.json
# IDENTITY_HUB_JWKS_URL=http://localhost:8000/.well-known/jwks.json

# OAuth client credentials registered in Identity Hub
OAUTH_CLIENT_ID=intranet
OAUTH_CLIENT_SECRET=replace_me

# OAuth redirect URI where the Identity Provider will send the authorization code
# This endpoint belongs to the client backend, which will handle the OAuth callback
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_ISSUER=identity-hub

# Optional frontend base URL.
# Development example: http://localhost:4200
# Production can omit it so redirects use /admin and /auth/error on this Nest server.
INTRANET_UI_BASE_URL=http://localhost:4200

# Cookie settings. Use AUTH_COOKIE_SECURE=true behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# First local admin bootstrap. This must be an Identity Hub externalKey.
# Login does not promote users automatically.
# BOOTSTRAP_ADMIN_EXTERNAL_KEY=IDH-U-...
