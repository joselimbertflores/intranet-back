# Application
NODE_ENV=development
PORT=3000

# Public URL of this backend. OAuth callback and public file URLs are derived from it.
# HTTP is supported for local/internal use; HTTPS is recommended for deployed environments.
INTRANET_PUBLIC_URL=http://localhost:3000

# Optional Angular URL when it runs on a separate origin. Also enables CORS for that origin.
# Omit it when NestJS serves the Angular build from INTRANET_PUBLIC_URL.
INTRANET_UI_URL=http://localhost:4200

# File storage
UPLOAD_PATH=storage/uploads

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=intranet
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Use true only for local development. Production requires false and migrations.
DATABASE_SYNCHRONIZE=true

# Identity Hub
# Exact public URL emitted as the JWT issuer and used for authorize, token and JWKS.
IDENTITY_HUB_PUBLIC_URL=http://localhost:8000

# Optional server-to-server base URL for the internal user directory.
# Omit it when the backend can reach IDENTITY_HUB_PUBLIC_URL directly.
# IDENTITY_HUB_INTERNAL_URL=http://localhost:8000

# Confidential OAuth client registered in Identity Hub.
OAUTH_CLIENT_ID=intranet
OAUTH_CLIENT_SECRET=replace-me

# Opaque local cookies. Secure=true is recommended and required with SameSite=none.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Initial local administrator. Set only while running npm run bootstrap:admin.
# BOOTSTRAP_ADMIN_EXTERNAL_KEY=IDH-U-...
